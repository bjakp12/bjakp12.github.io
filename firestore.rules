rules_version = '2';
// Public site can READ everything (needed to render the portfolio).
// Only signed-in admins can CREATE / UPDATE / DELETE.
// Publish via: Firestore Database → Rules tab → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
